{
  "manifest_version": 3,
  "name": "ChatMind - Live Chat 1-Click Smart Assist",
  "version": "1.0.0",
  "description": "Smart reply assistant and automated chat history backup for live chat support backends.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.as6868.com/*",
    "*://skgaming21.as6868.com/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatMind Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.as6868.com/*",
        "*://*/*#chat*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "knowledge_base.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
